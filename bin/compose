#!/usr/bin/env bash

export PROJECT_NAME="${PROJECT_NAME:-$(basename "$PROJECT_PATH")}"

MERGE_COMPOSE="${RUNDOCK_MERGE_COMPOSE:-true}"

CMD="docker compose -p $PROJECT_NAME-$RUNDOCK_ENV"

if command -v docker-compose &> /dev/null
then
    CMD="docker-compose -p $PROJECT_NAME-$RUNDOCK_ENV"
fi

printf "PROJECT: $PROJECT_NAME ($RUNDOCK_ENV)\n\n"

load_config() {
    if [[ -d "$1" ]]
    then
        for config in $(find "$1" -regex '^\(.*yml\|.*yaml\)$')
        do
            CMD+=" -f $config"

            if [[ "$(basename $config)" =~ "supervisor" ]]
            then
                if [[ ! -d "$PROJECT_PATH/storage/logs/supervisor" ]]
                then
                    mkdir "$PROJECT_PATH/storage/logs/supervisor"
                fi
            fi
        done
    else
        printf "Directory $1 does not exists. [2]\n\n"

        exit
    fi
}

use_default_config() {
    load_config "$COMPOSE_CONF_PATH"
}

if [[ -d "$RUNDOCK_PATH/$RUNDOCK_ENV-confs" ]]
then
    if $MERGE_COMPOSE -eq true
    then
        use_default_config
    fi

    load_config "$RUNDOCK_PATH/$RUNDOCK_ENV-confs"
else
    use_default_config
fi

# Run docker compose
$CMD ${@}