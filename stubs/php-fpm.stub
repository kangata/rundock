services:
  php:
    image: quetzalarc/php-laravel::tag
    restart: always
    volumes:
      - ${PROJECT_PATH}:/var/www/html
      - ${SERVICE_CONF_DIR}/php/php.ini:/usr/local/etc/php/php.ini
      - ${SERVICE_CONF_DIR}/php-fpm.d/zz-docker.conf:/usr/local/etc/php-fpm.d/zz-docker.conf
      - ${RUNDOCK_PATH}/data/.config:/.config
    logging:
      options:
        max-file: '1'
        max-size: '1m'
    environment:
      - TZ=Asia/Jakarta

networks:
  default:
    name: ${NETWORK_DEFAULT_NAME:-$PROJECT_NAME}
    external: ${NETWORK_DEFAULT_EXTERNAL:-false}