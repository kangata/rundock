services:
  app:
    image: quetzalarc/php-laravel::tag
    restart: always
    volumes:
      - ${PROJECT_PATH}:/var/www/html
      - ${APP_SERVICE_CONF_PATH:-$SERVICE_CONF_PATH}/php/php.ini:/usr/local/etc/php/php.ini
      - ${APP_SERVICE_CONF_PATH:-$SERVICE_CONF_PATH}/php-fpm.d/zz-docker.conf:/usr/local/etc/php-fpm.d/zz-docker.conf
    logging:
      options:
        max-file: '1'
        max-size: '1m'
    environment:
      - TZ=${TIMEZONE:-Asia/Jakarta}
  nginx:
    image: nginx:alpine
    restart: always
    depends_on:
      - app
    volumes:
      - ${PROJECT_PATH}:/var/www/html
      - ${PROJECT_PATH}/storage/logs/nginx:/var/log/nginx
      - ${NGINX_SERVICE_CONF_PATH:-$SERVICE_CONF_PATH}/nginx/nginx.conf:/etc/nginx/nginx.conf
      - ${NGINX_SERVICE_CONF_PATH:-$SERVICE_CONF_PATH}/nginx/templates:/etc/nginx/templates
    ports:
      - ${NGINX_HTTP_PORT:-8000}:80
    logging:
      options:
        max-file: '1'
        max-size: '1m'
    environment:
      - APP_HOST=${NGINX_APP_HOST:-app}
      - TZ=${TIMEZONE:-Asia/Jakarta}

networks:
  default:
    name: ${NETWORK_DEFAULT_NAME:-$PROJECT_NAME}
    external: ${NETWORK_DEFAULT_EXTERNAL:-false}
