services:
  app:
    image: quetzalarc/php-laravel::tag
    restart: always
    ports:
      - ${OCTANE_HTTP_PORT:-8080}:80
    volumes:
      - ${PROJECT_PATH}:/app
    logging:
      options:
        max-file: '1'
        max-size: '1m'
    environment:
      - OCTANE_USER=${OCTANE_USER:-www-data}
      - OCTANE_PORT=${OCTANE_PORT:-80}
      - OCTANE_WORKER=${OCTANE_WORKER:-4}
      - OCTANE_TASK_WORKERS=${OCTANE_TASK_WORKERS:-4}
      - OCTANE_MAX_REQUESTS=${OCTANE_MAX_REQUESTS:-250}
      - TZ=${TIMEZONE:-Asia/Jakarta}

networks:
  default:
    name: ${NETWORK_DEFAULT_NAME:-$PROJECT_NAME}
    external: ${NETWORK_DEFAULT_EXTERNAL:-false}
