services:
  mailpit:
    image: axllent/mailpit
    restart: always
    ports:
      - ${FORWARD_MAILPIT_WEB_UI_PORT:-8025}:8025
      - ${FORWARD_MAILPIT_SMTP_PORT:-1025}:1025
    volumes:
      - ${RUNDOCK_PATH}/data/mailpit:/data
    environment:
      - TZ=Asia/Jakarta
      - MP_DATA_FILE=/data/mailpit.db