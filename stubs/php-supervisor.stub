services:
  supervisor:
    image: quetzalarc/php-laravel::tag
    restart: always
    volumes:
      - ${PROJECT_PATH}:/var/www/html
      - ${PROJECT_PATH}/storage/logs/supervisor:/var/log/supervisor
      - ${SERVICE_CONF_PATH}/supervisor/conf.d:/etc/supervisor/conf.d
    logging:
      options:
        max-file: '1'
        max-size: '1m'
    environment:
      - TZ=${TIMEZONE:-Asia/Jakarta}