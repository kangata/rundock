#!/usr/bin/env bash

export RUNDOCK_BASE_PATH="$(realpath $(dirname $(dirname $0)))"
export RUNDOCK_BIN_PATH="$RUNDOCK_BASE_PATH/bin"
export RUNDOCK_STUBS_PATH="$RUNDOCK_BASE_PATH/stubs"

export RUNDOCK_DIR_NAME="${RUNDOCK_DIR_NAME:-rundock}"

export PROJECT_PATH="$(realpath $(dirname $(dirname $(dirname $RUNDOCK_BASE_PATH))))"

export RUNDOCK_PATH="$PROJECT_PATH/$RUNDOCK_DIR_NAME"
export RUNDOCK_DATA_PATH="$RUNDOCK_PATH/data"
export RUNDOCK_CONFIG_PATH="$RUNDOCK_DATA_PATH/.config"

if [[ ! -d "$RUNDOCK_DATA_PATH" ]]
then
    mkdir -p "$RUNDOCK_DATA_PATH"
fi

if [[ ! -d "$RUNDOCK_CONFIG_PATH" ]]
then
    mkdir -p "$RUNDOCK_CONFIG_PATH"
fi

# Read .env file
if [[ -f "$RUNDOCK_PATH/.env" ]]
then
    export $(grep -v "^#" "$RUNDOCK_PATH/.env" | xargs)
fi

export APP_ENV="${RUNDOCK_APP_ENV:-dev}"

export COMPOSE_CONF_PATH="${OVERRIDE_COMPOSE_CONF_PATH:-${RUNDOCK_CONFIG_PATH}}/$APP_ENV-confs"
export SERVICE_CONF_PATH="${OVERRIDE_SERVICE_CONF_PATH:-${RUNDOCK_CONFIG_PATH}}"

if [[ ! -d "$COMPOSE_CONF_PATH" ]]
then
    mkdir -p "$COMPOSE_CONF_PATH"
fi

if [[ ! -d "$SERVICE_CONF_PATH" ]]
then
    mkdir -p "$SERVICE_CONF_PATH"
fi

PUID="${RUNDOCK_PUID:-33}"
PGID="${RUNDOCK_PGID:-33}"

COMPOSE="$RUNDOCK_BIN_PATH/compose"
EXEC_AS_ROOT="$COMPOSE exec"
EXEC_AS_USER="$COMPOSE exec -u $PUID:$PGID"
PHP_SERVICE_NAME="${PHP_SERVICE_NAME:-app}"

declare -A tags
tags[app-nginx]="8.4-fpm-alpine"
tags[nginx]="alpine"
tags[php-cron]="8.4-cron-alpine"
tags[php-fpm]="8.4-fpm-alpine"
tags[php-supervisor]="8.4-supervisor-alpine"
tags[php-swoole]="8.4-swoole-alpine"
tags[redis]="alpine"

# Check environment
if [[ "$1" == "local" || "$1" == "dev" || "$1" == "staging" || "$1" == "production" ]]
then
    APP_ENV=$1

    shift 1
fi

if [[ "$1" == "--run" ]]
then
    if [[ "$3" =~ "composer" ||  "$3" =~ "git" || "$3" =~ "php" ]]
    then
        docker run -it --rm \
            -u "$PUID:$PGID" \
            -v "$PROJECT_PATH":/var/www/html \
            -w /var/www/html \
            quetzalarc/php-laravel:"$2" ${@:3}
    fi

    exit
fi

# Add service
if [[ "$1" == "add" ]]
then
    if [[ ! -f "$RUNDOCK_STUBS_PATH/$2.stub" ]]
    then
        printf "File $RUNDOCK_STUBS_PATH/$2.stub does not exists.\n"

        exit
    fi

    cp "$RUNDOCK_STUBS_PATH/$2.stub" "$COMPOSE_CONF_PATH/$2.yaml"

    if [[ "$3" ]]
    then
        sed -i -E "s/:tag/$3/g" "$COMPOSE_CONF_PATH/$2.yaml"
    else
        sed -i -E "s/:tag/${tags[$2]}/g" "$COMPOSE_CONF_PATH/$2.yaml"
    fi

    # Add nginx config
    if [[ "$2" =~ "app-nginx" || "$2" =~ "nginx" ]]
    then
        if [[ ! -d "$SERVICE_CONF_PATH/nginx/templates" ]]
        then
            mkdir -p "$SERVICE_CONF_PATH/nginx/templates"
        fi

        cp "$RUNDOCK_BASE_PATH/nginx/nginx.conf" "$SERVICE_CONF_PATH/nginx/nginx.conf"
        cp "$RUNDOCK_BASE_PATH/nginx/templates/default.conf.template" "$SERVICE_CONF_PATH/nginx/templates/default.conf.template"
    fi

    # Add php config
    if [[ "$2" =~ "app-nginx" || "$2" =~ "php-fpm" ]]
    then
        if [[ ! -d "$SERVICE_CONF_PATH/php-fpm.d" ]]
        then
            mkdir -p "$SERVICE_CONF_PATH/php-fpm.d"
        fi

        cp "$RUNDOCK_BASE_PATH/php-fpm.d/zz-docker.conf-default" "$SERVICE_CONF_PATH/php-fpm.d/zz-docker.conf"

        sed -i -E "s/^user = .*/user = $PUID/g" "$SERVICE_CONF_PATH/php-fpm.d/zz-docker.conf"
        sed -i -E "s/^group = .*/group = $PUID/g" "$SERVICE_CONF_PATH/php-fpm.d/zz-docker.conf"

        if [[ ! -d "$SERVICE_CONF_PATH/php" ]]
        then
            mkdir -p "$SERVICE_CONF_PATH/php"
        fi

        if [[ "$APP_ENV" == "local" || "$APP_ENV" == "dev" ]]
        then
            cp "$RUNDOCK_BASE_PATH/php/php.ini-development" "$SERVICE_CONF_PATH/php/php.ini"
        else
            cp "$RUNDOCK_BASE_PATH/php/php.ini-production" "$SERVICE_CONF_PATH/php/php.ini"
        fi
    fi

    if [[ "$2" =~ "php-cron" ]]
    then
        if [[ ! -d "$SERVICE_CONF_PATH/cron" ]]
        then
            mkdir -p "$SERVICE_CONF_PATH/cron"
        fi

        cp "$RUNDOCK_BASE_PATH/cron/schedule_run.sh.template" "$SERVICE_CONF_PATH/cron/schedule_run.sh"
    fi

    if [[ "$2" =~ "supervisor" ]]
    then
        if [[ ! -d "$SERVICE_CONF_PATH/supervisor/conf.d" ]]
        then
            mkdir -p "$SERVICE_CONF_PATH/supervisor/conf.d"
        fi

        cp "$RUNDOCK_BASE_PATH/supervisor/conf.d/supervisord.conf-default" "$SERVICE_CONF_PATH/supervisor/conf.d/supervisord.conf"

        if [[ "$3" == "--horizon" || "$4" == "--horizon" ]]
        then
            cp "$RUNDOCK_BASE_PATH/supervisor/conf.d/horizon.conf-default" "$SERVICE_CONF_PATH/supervisor/conf.d/horizon.conf"

            sed -i -E "s/^user=.*/user=$PUID/g" "$SERVICE_CONF_PATH/supervisor/conf.d/horizon.conf"
        else
            cp "$RUNDOCK_BASE_PATH/supervisor/conf.d/default.conf-default" "$SERVICE_CONF_PATH/supervisor/conf.d/default.conf"

            sed -i -E "s/^user=.*/user=$PUID/g" "$SERVICE_CONF_PATH/supervisor/conf.d/default.conf"
        fi
    fi

    echo "$2: added"

    exit
fi

if [[ "$1" == "remove" ]]
then
    if [[ ! -f "$COMPOSE_CONF_PATH/$2.yaml" ]]
    then
        printf "Service not installed.\n"

        exit
    fi

    rm "$COMPOSE_CONF_PATH/$2.yaml"

    echo "$2: removed"

    exit
fi

# Publish services
if [[ "$1" == "publish:services" ]]
then
    if [[ ! -d "$RUNDOCK_PATH" ]]
    then
        mkdir "$RUNDOCK_PATH"
    fi

    cp -r "$COMPOSE_CONF_PATH" "$RUNDOCK_PATH/"

    for file in $(find "$RUNDOCK_PATH/$APP_ENV-confs" -regex '^\(.*yml\|.*yaml\)$')
    do
        sed -i 's#${RUNDOCK_BASE_PATH}#${RUNDOCK_PATH}#g' $file
    done

    exit
fi

# Publish config
if [[ "$1" == "publish:config" ]]
then
    if [[ ! -f "$RUNDOCK_STUBS_PATH/$2.stub" ]]
    then
        printf "Service $2 does not exists.\n"

        exit
    fi

    if [[ ! -d "$RUNDOCK_PATH" ]]
    then
        mkdir "$RUNDOCK_PATH"
    fi

    if [[ "$2" =~ "app-nginx" || "$2" =~ "php-fpm" ]]
    then
        cp -r "$SERVICE_CONF_PATH/nginx" "$RUNDOCK_PATH/"

        cp -r "$SERVICE_CONF_PATH/php-fpm.d" "$RUNDOCK_PATH/"
        cp -r "$SERVICE_CONF_PATH/php" "$RUNDOCK_PATH/"

        exit
    fi

    if [[ "$2" =~ "php-cron" ]]
    then
        cp -r "$SERVICE_CONF_PATH/cron" "$RUNDOCK_PATH/"

        exit
    fi

    if [[ "$2" =~ "supervisor" ]]
    then
        cp -r "$SERVICE_CONF_PATH/supervisor" "$RUNDOCK_PATH/"

        exit
    fi
fi

# Publish shortcut
if [[ "$1" == "publish:shortcut" ]]
then
    cp $RUNDOCK_BASE_PATH/shortcut/* $RUNDOCK_PATH/

    exit
fi

# Command alias
if [[ "$1" == "artisan" || "$1" == "a" ]]
then
    $EXEC_AS_USER $PHP_SERVICE_NAME php artisan ${@:2}

    exit
fi

if [[ "$1" == "git"  ]]
then
    $EXEC_AS_USER $PHP_SERVICE_NAME ${@}

    exit
fi

if [[ "$1" == "php" || "$1" == "composer" ]]
then
    $EXEC_AS_USER $PHP_SERVICE_NAME ${@}

    exit
fi

if [[ "$1" == "nginx" ]]
then
    $EXEC_AS_ROOT nginx ${@}

    exit
fi

if [[ "$1" == "redis-cli" ]]
then
    $EXEC_AS_ROOT redis ${@}

    exit
fi

if [[ "$1" == "supervisorctl" ]]
then
    $EXEC_AS_ROOT supervisor ${@}

    exit
fi

$COMPOSE ${@}
